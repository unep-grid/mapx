{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived from OGC landingPage.yaml, 2026-07-08.",
  "type": "object",
  "required": ["title", "description", "links"],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/link"
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "rel": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
