{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived from OGC recordCollectionGeoJSON.yaml, 2026-07-08.",
  "type": "object",
  "required": ["type", "numberMatched", "numberReturned", "features", "links"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["FeatureCollection"]
    },
    "timeStamp": {
      "type": "string"
    },
    "numberMatched": {
      "type": "integer",
      "minimum": 0
    },
    "numberReturned": {
      "type": "integer",
      "minimum": 0
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "recordGeoJSON.schema.json"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/link"
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "rel": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
