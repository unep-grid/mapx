{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived from OGC recordGeoJSON.yaml and recordCommonProperties.yaml, 2026-07-08.",
  "type": "object",
  "required": ["id", "type", "geometry", "properties", "links"],
  "properties": {
    "id": {
      "type": ["string", "integer"]
    },
    "type": {
      "type": "string",
      "enum": ["Feature"]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/polygon"
        }
      ]
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "properties": {
      "type": "object",
      "required": ["type", "title", "description", "language", "languages", "mapx"],
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created": {
          "type": ["string", "null"]
        },
        "updated": {
          "type": ["string", "null"]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array"
        },
        "mapx": {
          "type": "object",
          "required": ["view_id", "project_id", "view_type", "projects_id"],
          "properties": {
            "view_id": {
              "type": "string"
            },
            "project_id": {
              "type": ["string", "null"]
            },
            "view_type": {
              "type": "string"
            },
            "projects_id": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/link"
      }
    }
  },
  "definitions": {
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon"]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "rel": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
